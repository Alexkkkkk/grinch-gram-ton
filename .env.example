# ════════════════════════════════════════════════════════════════════════════════# GRINCH-GRAM → DeDust DEX Spot Grid Bot (TON Blockchain)# ════════════════════════════════════════════════════════════════════════════════# ── TON Кошелёк (24 слова мнемоники от TonKeeper / mytonwallet) ───────────────# ⚠️  Замените на реальную мнемонику! Бот отправляет транзакции с этого кошелька.TON_MNEMONIC=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12 word13 word14 word15 word16 word17 word18 word19 word20 word21 word22 word23 word24# ── Режим торговли ──TRADE_MODE=dedustEXCHANGE=binanceDEMO_MODE=false# ── Рынок ──# Формат: TOKEN/TON. Можно указать любую пару на DeDustSYMBOL=GRINCH/TONTIMEFRAME=15m# ── Адрес токена (Jetton на TON) ──# По умолчанию GRINCH. Для другой пары замените на адрес нужного JettonTOKEN_ADDRESS=EQA6G0uVERDZTkLNa0drWBna1F5TSbogy7UXEWU5ERHz4uJL# Обратная совместимость (необязательно)GRINCH_TOKEN_ADDRESS=EQA6G0uVERDZTkLNa0drWBna1F5TSbogy7UXEWU5ERHz4uJLGRINCH_POOL_ADDRESS=EQDpVwTQr53cwgaT_VCFsmrleg5fBvStTjMrvyvprF_ROC9Z# ── Комиссия DEX ──# DeDust volatile pool: 0.25% за сторону (0.5% round-trip)# DeDust stableswap pool: 0.05% за сторону (0.1% round-trip)# DeDust TON/USDT pool: 0.1% за сторону (0.2% round-trip)FEE_PCT=0.25# ── Сетка (Spot Grid) ──GRID_MODE=1GRID_COUNT=40GRID_STEP_PCT=3.5GRID_MIN_STEP_PCT=3.0GRID_MAX_STEP_PCT=8.0GRID_SELL_LEVELS=20GRID_BUY_LEVELS=20GRID_ADAPTIVE_STEP=1GRID_TICK_SEC=15GRID_TICK_INTERVAL=15GRID_RECENTER_THRESHOLD=1.8GRID_RECENTER_COOLDOWN=1800GRID_DB_PATH=/app/data/grid_grinch_gram.db# ── Капитал ──# TON на каждый BUY-уровень. Весь капитал = TRADE_AMOUNT × GRID_BUY_LEVELSTRADE_AMOUNT=100# ── Защита ──SLIPPAGE_PCT=5.0GAS_RESERVE_TON=0.45SELL_GAS_TON=0.253BUY_GAS_TON=0.103MIN_STAKE_TON=0.0# ── AI (отключён для чистой сетки) ──AI_FULL_RIGHTS=0# ── GitHub (опционально, для авто-деплоя и репортов) ──GITHUB_TOKEN=GITHUB_REPO=Alexkkkkk/grinch-gram-tonREPORT_ERRORS=true# ── Telegram уведомления (опционально) ──TELEGRAM_BOT_TOKEN=TELEGRAM_CHAT_ID=# ── Flask ──SECRET_KEY=change-me-grinch-gram-2026
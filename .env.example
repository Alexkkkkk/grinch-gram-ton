# ═══════════════════════════════════════════════════════════════════════════════
# GRINCH-GRAM → GRINCH/GRAM (GRINCH/TON) Spot Grid на DeDust
# ═══════════════════════════════════════════════════════════════════════════════

# ── TON Кошелёк (24 слова мнемоники от TonKeeper / mytonwallet) ──────────────
# ⚠️  Замените на реальную мнемонику! Бот отправляет транзакции с этого кошелька.
TON_MNEMONIC=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12 word13 word14 word15 word16 word17 word18 word19 word20 word21 word22 word23 word24

# ── Режим торговли ──
TRADE_MODE=dedust
EXCHANGE=binance
DEMO_MODE=false

# ── Рынок ──
SYMBOL=GRINCH/TON
TIMEFRAME=15m

# ── Адреса контрактов (GRINCH на TON) ──
GRINCH_TOKEN_ADDRESS=EQA6G0uVERDZTkLNa0drWBna1F5TSbogy7UXEWU5ERHz4uJL
GRINCH_POOL_ADDRESS=EQDpVwTQr53cwgaT_VCFsmrleg5fBvStTjMrvyvprF_ROC9Z

# ── Комиссия DEX (1% за сторону на DeDust) ──
FEE_PCT=1.0

# ── Сетка (Spot Grid) ──
GRID_MODE=1
GRID_COUNT=40
GRID_STEP_PCT=3.5
GRID_MIN_STEP_PCT=3.0
GRID_MAX_STEP_PCT=8.0
GRID_SELL_LEVELS=20
GRID_BUY_LEVELS=20
GRID_ADAPTIVE_STEP=1
GRID_TICK_SEC=15
GRID_TICK_INTERVAL=15
GRID_RECENTER_THRESHOLD=1.8
GRID_RECENTER_COOLDOWN=1800
GRID_DB_PATH=grid_grinch_gram.db

# ── Капитал ──
# TON на каждый BUY-уровень. Весь капитал = TRADE_AMOUNT × GRID_BUY_LEVELS
TRADE_AMOUNT=100

# ── Защита ──
SLIPPAGE_PCT=5.0
GAS_RESERVE_TON=0.45
SELL_GAS_TON=0.253
BUY_GAS_TON=0.103
MIN_STAKE_TON=0.0

# ── AI (отключён для чистой сетки) ──
AI_FULL_RIGHTS=0

# ── GitHub (опционально, для репортов ошибок) ──
GITHUB_TOKEN=
GITHUB_REPO=Alexkkkkk/GRINCH-GRAM
REPORT_ERRORS=true

# ── Flask ──
SECRET_KEY=change-me-grinch-gram-2026

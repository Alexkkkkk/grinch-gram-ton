# ═══════════════════════════════════════════════════════════════════════════════
# QuantumGrinch v7 — TON/USDT Trading Bot
# ═══════════════════════════════════════════════════════════════════════════════

# ── TON Wallet (ОБЯЗАТЕЛЬНО) ──────────────────────────────────────────────────
TON_MNEMONIC=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12 word13 word14 word15 word16 word17 word18 word19 word20 word21 word22 word23 word24
TON_WALLET=EQ...your_wallet_address...

# ── API Keys ──────────────────────────────────────────────────────────────────
TONCENTER_API_KEY=your_toncenter_api_key
COINMARKETCAP_API_KEY=your_cmc_api_key

# ── Trading Configuration ───────────────────────────────────────────────────────
# Official DeDust TON/USDT mainnet addresses
USDT_TOKEN_ADDRESS=EQCxE6mUtQJKFnGfaROTKOt1kCixRv7Nw2Id_sDs
USDT_POOL_ADDRESS=EQA-X_yo3fzzbDbJ_0bzFWKqtRuZFIRa1sJsveZJ1YpViO3r
TRADE_MODE=dedust
SYMBOL=TON/USDT
TRADE_AMOUNT=0.1
GRID_LEVELS=20
GRID_SPREAD_PCT=3.5
TAKE_PROFIT_PCT=6.0
STOP_LOSS_PCT=3.0
TRAILING_STOP_PCT=3.0
DCA_ENABLED=true
DCA_STAKE_TON=0.3
DCA_TARGET_PROFIT_PCT=10.0
DCA_MAX_ENTRIES=5

# ── AI / Quantum Intelligence Suite ───────────────────────────────────────────
AI_ENABLED=true
AI_MIN_CONFIDENCE=55.0
AI_MODEL_PATH=./models

# ── Local LLM (Ollama / llamafile) ────────────────────────────────────────────
# Grid controller + news sentiment can run on a local model instead of Groq/Kimi.
# Ollama:    ollama pull llama3.1:8b && ollama serve   (port 11434)
# llamafile: ./model.llamafile --port 8080
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.1:8b
# LLAMAFILE_BASE_URL=http://127.0.0.1:8080/v1
# LLAMAFILE_MODEL=llamafile
# LLM_NEWS_ENABLED=true

# ── Security ───────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-64-char-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# ── Web Server ─────────────────────────────────────────────────────────────────
PORT=3000
# Gunicorn worker threads. 32 on a 2-vCPU host only adds context switching;
# this workload is I/O-bound, so 8-16 is enough.
GUNICORN_THREADS=8

# ── Hard Risk Limits ───────────────────────────────────────────────────────────
RISK_LIMITS_ENABLED=1
MAX_DAILY_LOSS_TON=0.5
MAX_DAILY_LOSS_PCT=3.0
MAX_TRADES_PER_DAY=200
MAX_TRADES_PER_HOUR=30
MAX_POSITION_TON=0
MAX_GAS_PCT_OF_PROFIT=35
MIN_EXPECTED_NET_PCT=0.8
LOSS_STREAK_PAUSE=5
PAUSE_AFTER_LOSS_STREAK_SEC=3600
KILL_SWITCH_FILE=/tmp/grinch_stop
RISK_STATE_PATH=risk_state.json

# Real DeDust pool fee. Default FEE_PCT=1.0 makes grid steps below ~2.45%
# unprofitable (see _min_profitable_order_ton).
FEE_PCT=0.5

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Live DeDust TON/USDT grid defaults
GRID_SYMBOL=TONUSDT
GRID_SYMBOL_DEDUST=TON/USDT
GRID_COUNT=6
GRID_SELL_LEVELS=3
GRID_BUY_LEVELS=3
GRID_INVESTMENT=0.6
# Keep the safety gate enabled by default; opt in on a controlled wallet only.
GRID_MIN_ORDER_TON=15
GRID_ALLOW_UNPROFITABLE_ORDERS=0

# Super-aggressive adaptive grid (enable only after reviewing risk)
# GRID_SUPER_AGGRESSIVE=1
# GRID_ADAPTIVE_STEP=1
# GRID_STEP_PCT=2.5
# GRID_MIN_STEP_PCT=2.0
# GRID_MAX_STEP_PCT=4.0
# GRID_SELL_AS_TON=1
# GRID_SELL_AMOUNT_TON=0
# GRID_REINVEST_PROFIT_PCT=100

# ── MAX-DENSITY GRID PRESET (applied on VPS 2026-09-19, see .env on server) ───
# Floor step 2.2% = min profitable step for 0.40 TON orders at fee 0.10%/side,
# gas 0.004 TON/tx: (1+s)*(1-0.001)^2-1 >= 0.008/0.40 -> s_min ≈ 2.004%.
GRID_COUNT=40
GRID_SELL_LEVELS=24
GRID_BUY_LEVELS=24
GRID_MIN_STEP_PCT=2.2
GRID_MAX_STEP_PCT=6.0
GROQ_MAX_TOTAL_LEVELS=48
GROQ_TARGET_SELL_LEVELS=24
GROQ_TARGET_BUY_LEVELS=24
GROQ_DENSIFY_MAX_ADD_LEVELS=2
GROQ_DENSIFY_MAX_TOTAL_LEVELS=48
GRID_DENSIFY_ENABLED=1
GRID_DENSITY_MODE=MAX_PROFITABLE
GRID_REINVEST_PROFIT_PCT=100
GROQ_REINVEST_BALANCE_PCT=100

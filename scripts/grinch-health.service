[Unit]
Description=GRINCH-GRAM Health Monitor
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/bot
Environment=PYTHONPATH=/opt/bot
EnvironmentFile=/opt/bot/.env
ExecStart=/usr/bin/python3 /opt/bot/scripts/health_monitor.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
